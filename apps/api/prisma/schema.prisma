generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tổ chức & người dùng ----------

model Organization {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  type       String // COMPANY | FACTORY | NPP | DEALER
  shortLabel String? // Ký hiệu ngắn dùng để sinh mã đơn, ví dụ "X.MinhViet" (chỉ Xưởng cần đặt)
  phone      String?
  address    String?
  province   String? // Tỉnh/Thành phố hoạt động (dùng cho Phân vùng)

  // Profile Fields cho Báo giá
  productionName String?
  logoUrl        String?
  mainCategories String?
  email          String?
  fanpage        String?

  users               User[]
  managedByNppId      String?
  managedByNpp        Organization?        @relation("NppManagesFactory", fields: [managedByNppId], references: [id])
  managedFactories    Organization[]       @relation("NppManagesFactory")
  ordersAsNpp         Order[]              @relation("OrderNppOrg")
  ordersAsFactory     Order[]              @relation("OrderFactoryOrg")
  debtsAsNpp          Debt[]               @relation("DebtNppOrg")
  debtsAsFactory      Debt[]               @relation("DebtFactoryOrg")
  nppProfileStocks    NppProfileStock[]    @relation("NppProfileStockOrg")
  nppStockMovements   NppStockMovement[]   @relation("NppStockMovementOrg")
  nppAccessories      NppAccessory[]       @relation("NppAccessoryOrg")
  nppGlassSheets      NppGlassSheet[]      @relation("NppGlassSheetOrg")
  salesTargets        SalesTarget[]        @relation("NppSalesTarget")
  workshopWorkers     WorkshopWorker[]     @relation("WorkshopWorkerOrg")
  workshopAttendances WorkshopAttendance[] @relation("WorkshopAttendanceOrg")
  workshopWorkdays    WorkshopWorkdaySetting[] @relation("WorkshopWorkdayOrg")
  workshopReminders   WorkshopReminder[]   @relation("WorkshopReminderOrg")
  formulaAccessGrant  FormulaAccessGrant?   @relation("FormulaGrantOrganization")
  formulaGrantsAsNpp  FormulaAccessGrant[]  @relation("FormulaGrantNpp")
  formulaInvitesAsNpp FormulaInvite[]       @relation("FormulaInviteNpp")
  formulaInvitesTarget FormulaInvite[]      @relation("FormulaInviteTarget")
  formulaAccessAudits FormulaAccessAudit[]  @relation("FormulaAuditOrganization")
  formulaAuditsFromNpp FormulaAccessAudit[] @relation("FormulaAuditFromNpp")
  formulaAuditsToNpp FormulaAccessAudit[]   @relation("FormulaAuditToNpp")
  eurohouseFeatureGrants EurohouseFeatureGrant[] @relation("EurohouseGrantOrganization")
  eurohouseGrantsAsNpp EurohouseFeatureGrant[] @relation("EurohouseGrantNpp")
  eurohouseInvitesAsNpp EurohouseInvite[] @relation("EurohouseInviteNpp")
  eurohouseInvitesTarget EurohouseInvite[] @relation("EurohouseInviteTarget")
  eurohouseAccessAudits EurohouseAccessAudit[] @relation("EurohouseAuditOrganization")
  eurohouseAuditsFromNpp EurohouseAccessAudit[] @relation("EurohouseAuditFromNpp")
  eurohouseAuditsToNpp EurohouseAccessAudit[] @relation("EurohouseAuditToNpp")
  tier                String? // Vàng, Bạc, Đồng (dành cho NPP/Đại lý)
  targetRevenue       Float                @default(0) // Mục tiêu doanh số
  purchasingPower     String? // Sức mua (JSON string, VD: {"Euroqueen": 80, "Ecento": 20})
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  emailNormalized       String?                @unique
  displayName           String
  phone                 String?
  phoneNormalized       String?                @unique
  verifiedAt            DateTime?
  verificationChannel   VerificationChannel?
  passwordHash          String
  role                  String // ADMIN | STAFF | NPP | DAILY | FACTORY
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id])
  // RBAC nội bộ công ty (Web Admin)
  departmentId          String?
  department            Department?            @relation(fields: [departmentId], references: [id])
  jobTitle              String                 @default("") // chức danh: CEO, Kế toán trưởng, Kế toán tạo đơn...
  isCeo                 Boolean                @default(false) // CEO: toàn quyền, bỏ qua mọi check module
  moduleAccess          String                 @default("[]") // (Legacy) JSON mảng module key được phép
  rbacRoleId            String?
  rbacRole              Role?                  @relation(fields: [rbacRoleId], references: [id])
  managedProvinces      String                 @default("[]") // JSON mảng Tỉnh/Thành phố mà Sale này quản lý
  projects              Project[]
  orders                Order[]
  stockMovements        StockMovement[]
  profileStockMovements ProfileStockMovement[]
  nppStockMovements     NppStockMovement[]     @relation("UserNppStockMovements")
  cashTransactions      CashTransaction[]
  quotations            Quotation[]
  warranties            Warranty[]
  points                Int                    @default(0) // số dư điểm tích lũy (cache; nguồn sự thật là PointLedger)
  pointLedgers          PointLedger[]
  giftRedemptions       GiftRedemption[]
  leads                 Lead[]                 @relation("LeadManagedBy")
  saleReports           SaleReport[]           @relation("SaleReportCreatedBy")
  payrolls              Payroll[]              @relation("UserPayroll")
  workOrders            WorkOrder[]            @relation("WorkOrderCreator")
  workerAccessories     WorkerAccessoryPrice[] @relation("WorkerAccessory")
  scrapKg               Float                  @default(0) // Nhôm phế liệu dự tính (kg)
  inventoryItems        InventoryItem[]        @relation("UserInventory")
  profileCutoffs        ProfileCutoff[]
  workshopReminders     WorkshopReminder[]     @relation("WorkshopReminderCreator")
  websiteContents       WebsiteContent[]       @relation("WebsiteContentCreatedBy")
  websiteRevisions      WebsiteContentRevision[] @relation("WebsiteRevisionCreatedBy")
  websiteReviews        WebsiteContentReview[] @relation("WebsiteReviewReviewer")
  websiteSeoReviews     WebsiteSeoRecord[]     @relation("WebsiteSeoReviewer")
  websiteMediaAssets    WebsiteMediaAsset[]    @relation("WebsiteMediaCreatedBy")
  websiteDocuments      WebsiteTechnicalDocument[] @relation("WebsiteDocumentCreatedBy")
  websiteRedirects      WebsiteRedirect[]      @relation("WebsiteRedirectCreatedBy")
  websiteAudits         WebsitePublicationAudit[] @relation("WebsiteAuditActor")
  verificationChallenges VerificationChallenge[]
  formulaGrantsActivated FormulaAccessGrant[] @relation("FormulaGrantActivatedBy")
  formulaGrantsRevoked FormulaAccessGrant[] @relation("FormulaGrantRevokedBy")
  formulaInvitesCreated FormulaInvite[] @relation("FormulaInviteCreatedBy")
  formulaInvitesUsed FormulaInvite[] @relation("FormulaInviteUsedBy")
  formulaAccessAudits FormulaAccessAudit[] @relation("FormulaAuditActor")
  eurohouseGrantsActivated EurohouseFeatureGrant[] @relation("EurohouseGrantActivatedBy")
  eurohouseGrantsRevoked EurohouseFeatureGrant[] @relation("EurohouseGrantRevokedBy")
  eurohouseInvitesCreated EurohouseInvite[] @relation("EurohouseInviteCreatedBy")
  eurohouseInvitesUsed EurohouseInvite[] @relation("EurohouseInviteUsedBy")
  eurohouseAccessAudits EurohouseAccessAudit[] @relation("EurohouseAuditActor")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([departmentId])
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum FormulaAccessStatus {
  ACTIVE
  REVOKED
}

enum FormulaAccessSource {
  NPP_INVITE
  NPP_DIRECT
  ADMIN_DIRECT
  MIGRATED
}

enum FormulaInviteStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum FormulaAccessAction {
  INVITE_CREATED
  INVITE_REDEEMED
  DIRECT_ACTIVATED
  REVOKED
  NPP_TRANSFERRED
}

enum EurohouseFeatureKey {
  FORMULA_CUTTING
  EUROHOUSE_ORDERING
}

enum EurohouseAccessStatus {
  LOCKED
  ACTIVE
  REVOKED
}

enum EurohouseAccessSource {
  NPP_INVITE
  NPP_DIRECT
  ADMIN_DIRECT
  MIGRATED
}

enum EurohouseInviteStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum EurohouseAccessAction {
  INVITE_CREATED
  INVITE_REDEEMED
  DIRECT_ACTIVATED
  REVOKED
  NPP_TRANSFERRED
}

model VerificationChallenge {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          VerificationChannel
  targetNormalized String
  codeHash         String
  expiresAt        DateTime
  attemptCount     Int                 @default(0)
  consumedAt       DateTime?
  createdAt        DateTime            @default(now())
  lastSentAt       DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([targetNormalized])
}

model FormulaAccessGrant {
  id                  String              @id @default(cuid())
  organizationId      String              @unique
  organization        Organization        @relation("FormulaGrantOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  status              FormulaAccessStatus
  nppOrganizationId   String?
  nppOrganization     Organization?       @relation("FormulaGrantNpp", fields: [nppOrganizationId], references: [id])
  source              FormulaAccessSource
  activatedByUserId   String
  activatedBy         User                @relation("FormulaGrantActivatedBy", fields: [activatedByUserId], references: [id])
  activatedAt         DateTime            @default(now())
  revokedByUserId     String?
  revokedBy           User?               @relation("FormulaGrantRevokedBy", fields: [revokedByUserId], references: [id])
  revokedAt           DateTime?
  revokeReason        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([nppOrganizationId, status])
}

model FormulaInvite {
  id                   String              @id @default(cuid())
  codeHash             String              @unique
  codePrefix           String
  codeLast4            String
  nppOrganizationId    String
  nppOrganization      Organization        @relation("FormulaInviteNpp", fields: [nppOrganizationId], references: [id])
  targetOrganizationId String
  targetOrganization   Organization        @relation("FormulaInviteTarget", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  createdByUserId      String
  createdBy            User                @relation("FormulaInviteCreatedBy", fields: [createdByUserId], references: [id])
  status               FormulaInviteStatus @default(ACTIVE)
  expiresAt            DateTime
  usedAt               DateTime?
  usedByUserId         String?
  usedBy               User?               @relation("FormulaInviteUsedBy", fields: [usedByUserId], references: [id])
  createdAt            DateTime            @default(now())
  revokedAt            DateTime?
  audits               FormulaAccessAudit[]

  @@index([nppOrganizationId, status])
  @@index([targetOrganizationId, status])
}

model FormulaAccessAudit {
  id                    String              @id @default(cuid())
  organizationId        String
  organization          Organization        @relation("FormulaAuditOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId            String
  actor                  User                @relation("FormulaAuditActor", fields: [actorUserId], references: [id])
  actorRole              String
  action                 FormulaAccessAction
  fromNppOrganizationId  String?
  fromNppOrganization    Organization?       @relation("FormulaAuditFromNpp", fields: [fromNppOrganizationId], references: [id])
  toNppOrganizationId    String?
  toNppOrganization      Organization?       @relation("FormulaAuditToNpp", fields: [toNppOrganizationId], references: [id])
  formulaInviteId        String?
  formulaInvite          FormulaInvite?      @relation(fields: [formulaInviteId], references: [id])
  metadata               Json?
  createdAt              DateTime            @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model EurohouseFeatureGrant {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation("EurohouseGrantOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  featureKey          EurohouseFeatureKey
  status              EurohouseAccessStatus
  nppOrganizationId   String?
  nppOrganization     Organization?           @relation("EurohouseGrantNpp", fields: [nppOrganizationId], references: [id], onDelete: SetNull)
  source              EurohouseAccessSource
  activatedByUserId   String
  activatedBy         User                    @relation("EurohouseGrantActivatedBy", fields: [activatedByUserId], references: [id])
  activatedAt         DateTime                @default(now())
  revokedByUserId     String?
  revokedBy           User?                   @relation("EurohouseGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedAt           DateTime?
  revokeReason        String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organizationId, featureKey])
  @@index([nppOrganizationId, featureKey, status])
}

model EurohouseInvite {
  id                   String                  @id @default(cuid())
  codeHash             String                  @unique
  codePrefix           String
  codeLast4            String
  featureKeys          EurohouseFeatureKey[]
  nppOrganizationId    String
  nppOrganization      Organization            @relation("EurohouseInviteNpp", fields: [nppOrganizationId], references: [id])
  targetOrganizationId String
  targetOrganization   Organization            @relation("EurohouseInviteTarget", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  createdByUserId      String
  createdBy            User                    @relation("EurohouseInviteCreatedBy", fields: [createdByUserId], references: [id])
  status               EurohouseInviteStatus   @default(ACTIVE)
  expiresAt            DateTime
  usedAt               DateTime?
  usedByUserId         String?
  usedBy               User?                   @relation("EurohouseInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now())
  revokedAt            DateTime?
  audits               EurohouseAccessAudit[]

  @@index([nppOrganizationId, status])
  @@index([targetOrganizationId, status])
}

model EurohouseAccessAudit {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation("EurohouseAuditOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  featureKey            EurohouseFeatureKey?
  actorUserId           String
  actor                 User                    @relation("EurohouseAuditActor", fields: [actorUserId], references: [id])
  actorRole             String
  action                EurohouseAccessAction
  fromNppOrganizationId String?
  fromNppOrganization   Organization?           @relation("EurohouseAuditFromNpp", fields: [fromNppOrganizationId], references: [id], onDelete: SetNull)
  toNppOrganizationId   String?
  toNppOrganization     Organization?           @relation("EurohouseAuditToNpp", fields: [toNppOrganizationId], references: [id], onDelete: SetNull)
  eurohouseInviteId     String?
  eurohouseInvite       EurohouseInvite?        @relation(fields: [eurohouseInviteId], references: [id], onDelete: SetNull)
  metadata              Json?
  createdAt             DateTime                @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([featureKey, createdAt])
}

model Department {
  id        String       @id @default(cuid())
  code      String       @unique // CEO, SALES, RETAIL, ACCOUNTING, HR, MATERIAL, PROD, WAREHOUSE, SECURITY, KITCHEN, PROD_*
  name      String
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  sortOrder Int          @default(0)
  users     User[]
  createdAt DateTime     @default(now())

  @@index([parentId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // VD: "Giám đốc Kinh doanh", "Kế toán viên"
  description String?
  permissions String   @default("[]") // JSON array các quyền, VD: ["sales:read", "sales:write", "accounting:read"]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Danh mục hệ nhôm ----------

model AluSystem {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String?
  sortOrder         Int                @default(0)
  profiles          Profile[]
  systemFormulas    SystemFormula[]
  knowledgeArticles KnowledgeArticle[]
  websiteContents   WebsiteContent[]           @relation("WebsiteContentAluSystem")
  websiteDocuments  WebsiteTechnicalDocument[] @relation("WebsiteDocumentAluSystem")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Profile {
  id                String                 @id @default(cuid())
  aluSystemId       String
  aluSystem         AluSystem              @relation(fields: [aluSystemId], references: [id])
  code              String // mã cây — không unique toàn cục vì nhiều hệ dùng chung phụ kiện/thanh giống nhau
  name              String
  thicknessMm       String? // ví dụ "1.0" hoặc "1 - 1.25"
  kgPerMeter        Float                  @default(0)
  barLengthMm       Int                    @default(6000) // chiều dài cây tiêu chuẩn
  barsPerBundle     Int                    @default(0) // quy cách bó
  pricePerKg        Int                    @default(0)
  imageUrl          String? // ảnh mặt cắt
  stockBars         Int                    @default(0) // tồn hiện tại theo cây
  lowStockAlert     Int                    @default(0) // ngưỡng cảnh báo tồn thấp (0 = không cảnh báo)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  orderItems        OrderItem[]
  stockMovements    ProfileStockMovement[]
  nppProfileStocks  NppProfileStock[]
  nppStockMovements NppStockMovement[]
  profileCutoffs    ProfileCutoff[]
  dies              Die[]
  workOrders        WorkOrder[]

  @@unique([aluSystemId, code])
}

model ColorCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  hex       String? // hiển thị màu
  createdAt DateTime @default(now())
}

// ---------- Đơn hàng (đặt hàng theo cây nhôm) ----------

model Order {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  clientRequestId       String?
  sourceType            String // FACTORY | DEALER | NPP | ADMIN
  createdById           String?
  createdBy             User?                  @relation(fields: [createdById], references: [id])
  factoryName           String                 @default("")
  factoryOrgId          String?
  factoryOrg            Organization?          @relation("OrderFactoryOrg", fields: [factoryOrgId], references: [id])
  dealerName            String                 @default("")
  nppName               String                 @default("")
  nppOrgId              String?
  nppOrg                Organization?          @relation("OrderNppOrg", fields: [nppOrgId], references: [id])
  customerName          String                 @default("")
  customerPhone         String                 @default("")
  deliveryAddress       String                 @default("")
  colorCode             String                 @default("")
  status                String                 @default("NEW")
  note                  String                 @default("")
  accessoriesNote       String                 @default("")
  totalKg               Float                  @default(0)
  theoreticalTotalKg    Float                  @default(0)
  actualTotalKg         Float?
  totalAmount           Int                    @default(0)
  pricingStatus         String                 @default("PENDING_NPP") // PENDING_NPP | FINALIZED | ESTIMATED_COMPANY
  finalUnitPricePerKg   Int?
  pricingDiscountAmount Int                   @default(0)
  pricingSurchargeAmount Int                  @default(0)
  pricingNote           String                 @default("")
  priceConfirmedAt      DateTime?
  priceConfirmedById    String?
  dueNote               String                 @default("")
  customerCode          String                 @default("") // Mã khách hàng (admin nhập khi xuất kho)
  invoiceNo             String                 @default("") // Số hóa đơn
  poNo                  String                 @default("") // Số đơn đặt hàng
  items                 OrderItem[]
  histories             OrderStatusHistory[]
  profileStockMovements ProfileStockMovement[]
  nppStockMovements     NppStockMovement[]     @relation("OrderNppStockMovements")
  debts                 Debt[]
  workOrders            WorkOrder[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([createdById, clientRequestId])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profileId          String?
  profile            Profile? @relation(fields: [profileId], references: [id])
  productCode        String
  productName        String
  colorCode          String   @default("")
  quantity           Int      @default(0) // số cây
  unit               String   @default("cây")
  totalKg            Float    @default(0)
  theoreticalTotalKg Float    @default(0)
  unitPrice          Int      @default(0)
  totalPrice         Int      @default(0)
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  note      String   @default("")
  actor     String   @default("")
  createdAt DateTime @default(now())
}

// ---------- Quản lý công trình & lợi nhuận (App Xưởng) ----------

model Project {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  organizationId  String?
  customerV2Id    String?
  customerV2      WorkshopCustomer? @relation(fields: [customerV2Id], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?             @relation(fields: [ownerId], references: [id])
  customerName    String            @default("")
  customerPhone   String            @default("")
  address         String            @default("")
  scale           String            @default("") // Quy mô dự án
  potentialRating Int               @default(0) // Mức độ tiềm năng 1-5
  productsUsed    String            @default("") // Dòng hàng sử dụng chủ đạo
  status          String            @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  startDate       DateTime? // Thời gian bắt đầu
  endDate         DateTime? // Thời gian kết thúc
  // Giá trị nhận với chủ nhà / Tổng doanh thu
  contractValue   Int               @default(0)

  // Nâng cấp tài chính công trình
  quotationId    String? // Lấy giá trị từ báo giá nào
  estimatedValue Int      @default(0) // Dự toán ban đầu (Lấy từ báo giá)
  incurredValue  Int      @default(0) // Phát sinh
  incurredType   String   @default("INCREASE") // INCREASE | DECREASE
  settledValue   Int      @default(0) // Quyết toán
  images         String[] @default([]) // Danh sách ảnh (tối đa 5 ảnh)

  // Chi phí đầu vào
  costAluminum     Int   @default(0)
  costAccessory    Int   @default(0)
  costLockHinge    Int   @default(0)
  costGlass        Int   @default(0)
  costGasket       Int   @default(0) // zoăng
  costSilicone     Int   @default(0)
  costScrew        Int   @default(0)
  costLabor        Int   @default(0)
  costPartnerPct   Float @default(0) // % chi phí cho đối tác
  costConsumables  Int   @default(0) // Vật tư phụ
  costTransport    Int   @default(0) // Vận chuyển
  costInstallation Int   @default(0) // Nhân công lắp đặt
  costOther        Int   @default(0) // Chi phí khác
  extraRevenue     Int   @default(0) // phát sinh tăng từ khách

  // Nợ đọng
  debtNpp       Int @default(0) // Nợ NPP
  debtAccessory Int @default(0) // Nợ NCC Phụ kiện
  debtGlass     Int @default(0) // Nợ NCC Kính
  debtOther     Int @default(0) // Nợ NCC Khác
  debtCustomer  Int @default(0) // Khách nợ mình

  note                 String                    @default("")
  archivedAt           DateTime?
  costs                ProjectCost[]
  debts                Debt[]
  cashTransactions     CashTransaction[]
  sites                ProjectSite[]
  openings             WorkshopOpening[]
  quickQuotes          WorkshopQuickQuote[]
  activities           WorkshopActivity[]
  operationsWorkOrders WorkshopWorkOrder[]
  installationJobs     WorkshopInstallationJob[]
  warrantyAssets       WorkshopWarrantyAsset[]
  websiteContents      WebsiteContent[]          @relation("WebsiteContentOperationalProject")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([organizationId, archivedAt, updatedAt])
  @@index([customerV2Id])
}

model ProjectCost {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String
  label     String
  amount    Int      @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Debt {
  id           String            @id @default(cuid())
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id])
  type         String // NPP | ACCESSORY | CUSTOMER
  direction    String            @default("PAYABLE") // PAYABLE (phải trả) | RECEIVABLE (phải thu)
  partnerName  String
  amount       Int               @default(0)
  paidAmount   Int               @default(0)
  status       String            @default("OPEN") // OPEN | PARTIAL | PAID
  bankAccount  String            @default("")
  bankName     String            @default("")
  note         String            @default("")
  dueDate      DateTime?
  // Công nợ NPP↔Xưởng: tự động sinh khi đơn hàng chuyển COMPLETED (xem eurohouse.service.ts).
  nppOrgId     String?
  nppOrg       Organization?     @relation("DebtNppOrg", fields: [nppOrgId], references: [id])
  factoryOrgId String?
  factoryOrg   Organization?     @relation("DebtFactoryOrg", fields: [factoryOrgId], references: [id])
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id])
  transactions CashTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([nppOrgId])
  @@index([factoryOrgId])
}

// ---------- Báo giá tự động ----------

model Quotation {
  id              String          @id @default(cuid())
  code            String          @unique
  createdById     String?
  createdBy       User?           @relation(fields: [createdById], references: [id])
  customerName    String          @default("")
  customerPhone   String          @default("")
  customerAddress String          @default("")
  items           QuotationItem[]

  // Tổng hợp chi phí từ các items
  areaM2     Float @default(0)
  baseAmount Int   @default(0)

  // Chi phí cộng thêm cho toàn bộ báo giá
  accessoryCost     Int     @default(0)
  laborCost         Int     @default(0)
  installCost       Int     @default(0)
  depreciation      Int     @default(0)
  profitPct         Float   @default(0)
  profitAmount      Int     @default(0)
  vatPct            Float   @default(0)
  vatAmount         Int     @default(0)
  totalAmount       Int     @default(0)
  notes             String? @default("")
  extraProducts     String? @db.Text
  isFinalSettlement Boolean @default(false)
  depositAmount     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([createdById])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  name                String  @default("") // VD: D1, VK1 (Ký hiệu)
  system              String  @default("") // Hệ nhôm
  doorType            String  @default("") // Loại cửa
  templateId          String? // Mã template Excel
  widthMm             Int     @default(0)
  heightMm            Int     @default(0)
  wallHugging         String  @default("Non") // Tường 200, 150, 250, Non
  quantity            Int     @default(1)
  includesAccessories Boolean @default(true)
  accessoriesPrice    Int     @default(0)

  // Bóc tách của từng bộ
  areaM2     Float @default(0)
  pricePerM2 Int   @default(0) // Đơn giá / m2
  totalPrice Int   @default(0) // Thành tiền

  // Thêm mới
  color           String?
  glassType       String?
  glassColor      String?
  dynamicInputs   Json?
  formulaSnapshot Json?
}

// ---------- Bảo hành ----------

model Warranty {
  id              String    @id @default(cuid())
  code            String    @unique // BH-YYMMDD-NN
  serialCode      String    @unique // mã QR/serial trên sản phẩm — mỗi mã chỉ kích hoạt 1 lần
  productName     String    @default("")
  systemCode      String    @default("")
  customerName    String    @default("")
  customerPhone   String    @default("")
  customerAddress String    @default("")
  projectName     String    @default("")
  warrantyMonths  Int       @default(24)
