  action         String
  note           String                 @default("")
  parts          Json?
  photoObjectIds String[]               @default([])
  actorId        String
  occurredAt     DateTime               @default(now())

  @@index([ticketId, occurredAt])
}

model WorkshopDomainEventOutbox {
