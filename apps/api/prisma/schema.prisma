  projectId   String? // Ghi nhận sinh ra từ công trình nào (nếu có)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

