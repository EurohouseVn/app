NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://<vercel-project>.vercel.app

# DEV (mặc định): SQLite, không cần cài gì
DATABASE_URL="file:./dev.db"

# Workshop OS V2.1 feature flags default to off.
V2_CANONICAL_DESIGN_ENABLED=false
V2_DATASET_RESOLVER_ENABLED=false
V2_PERSISTENT_BOM_ENABLED=false
V2_CUTTING_ENGINE_ENABLED=false
EUROHOUSE_DATASET_STUDIO=false
MANUFACTURING_TRACE_UI=false
MANUFACTURING_SHADOW_MODE=false
BOM_REVIEW_WORKFLOW=false

# Workshop Operations Track A surfaces remain opt-in until smoke verified.
WORKSHOP_SURVEY_V2=false
INVENTORY_V2=false
SHOP_FLOOR_V2=false
QC_V2=false
INSTALLATION_V2=false
WARRANTY_V2=false
WORKSHOP_EVENT_WORKER_ENABLED=true
WORKSHOP_EVENT_WORKER_INTERVAL_MS=15000

# Use S3-compatible storage for staging/production media durability.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# PRODUCTION: Postgres (Render/Neon). Khi deploy:
# 1. Đổi provider trong prisma/schema.prisma từ "sqlite" sang "postgresql"
# 2. Dán connection string Postgres vào đây
# DATABASE_URL=postgresql://user:pass@host:5432/eurohouse?schema=public

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
DEMO_ADMIN_EMAIL=board@eurohouse.vn
DEMO_ADMIN_PASSWORD=Eurohouse@2026
