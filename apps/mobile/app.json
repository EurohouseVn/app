{
  "expo": {
    "name": "Eurohouse",
    "slug": "eurohouse-mobile",
    "scheme": "eurohouse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./public/icon-512.png",
    "web": {
      "output": "static",
      "favicon": "./public/icon-192.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F47C20"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Eurohouse dùng camera để quét mã QR bảo hành trên sản phẩm."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
