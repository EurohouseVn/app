# Root
NODE_ENV=development

# API local
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://<vercel-project>.vercel.app
DATABASE_URL=postgresql://eurohouse:eurohouse@localhost:55432/eurohouse?schema=public

# Workshop OS V2.1 modules are independently enabled after technical review.
V2_CANONICAL_DESIGN_ENABLED=false
V2_DATASET_RESOLVER_ENABLED=false
V2_PERSISTENT_BOM_ENABLED=false
V2_CUTTING_ENGINE_ENABLED=false
EUROHOUSE_DATASET_STUDIO=false
MANUFACTURING_TRACE_UI=false
MANUFACTURING_SHADOW_MODE=false
BOM_REVIEW_WORKFLOW=false

# Workshop Operations Track A surfaces remain opt-in until smoke verified.
WORKSHOP_SURVEY_V2=false
INVENTORY_V2=false
SHOP_FLOOR_V2=false
QC_V2=false
INSTALLATION_V2=false
WARRANTY_V2=false
WORKSHOP_EVENT_WORKER_ENABLED=true
WORKSHOP_EVENT_WORKER_INTERVAL_MS=15000

# Durable media storage. Keep local only for developer machines.
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=eurohouse-workshop
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
REDIS_URL=redis://localhost:6379
# Bí mật ký JWT access token cho API (bắt buộc đổi ở production)
JWT_SECRET=change-me-eurohouse-secret
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Admin local / Vercel demo
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# NEXT_PUBLIC_API_URL=https://<render-service>.onrender.com/api

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3001/api
